meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "test",
    "password": "test",
    "server_password": "change_me_in_production"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar('token', res.body.token)
  }
}
