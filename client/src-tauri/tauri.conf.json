{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sorry",
  "version": "0.1.14",
  "identifier": "com.sorry.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Sorry",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--ignore-certificate-errors"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sorry"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Romain-Boudot/sorry/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NkVEQzNDRUNBODE3RkUKUldUK0Y2anNQTnh1NXdLMW9SRFpYWGhiOHc2Y0FlUDdQbG8xWDdScWlEc1VQTGZIUzd6cm1xWHEK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
